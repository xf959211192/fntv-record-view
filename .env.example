# Trakt 应用配置
TRAKT_CLIENT_ID=你的 Trakt Client ID
TRAKT_CLIENT_SECRET=你的 Trakt Client Secret
TRAKT_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Web 服务端口
APP_PORT=5000

# 时区
TZ=Asia/Shanghai

# 宿主机挂载路径
# Linux 示例：/usr/local/apps/@appdata/trim.media/database/trimmedia.db
# Windows Docker Desktop 示例：E:/xiaofeng/project/fntv-record-view/database/trimmedia.db
SRC_DB_FILE=./database/trimmedia.db
APP_RUNTIME_HOST_DIR=./runtime

# Trakt 自动同步
TRAKT_AUTO_SYNC_ENABLED=true
TRAKT_AUTO_SYNC_INTERVAL_SECONDS=1800
TRAKT_AUTO_SYNC_WATCHED_THRESHOLD=90
TRAKT_AUTO_SYNC_LIMIT=1000

# 可选：只同步某个用户，留空表示所有用户
TRAKT_AUTO_SYNC_USER_GUID=

# 可选：高级覆盖项，通常不需要修改
# TRAKT_API_BASE=https://api.trakt.tv
# APP_LOG_PATH=app.log
# TMP_DB_PATH=./runtime/trimmedia_tmp.db
# TRAKT_TOKEN_PATH=./runtime/trakt_tokens.json
# TRAKT_LAST_SYNC_PATH=./runtime/trakt_last_sync.json
# TRAKT_SETTINGS_PATH=./runtime/trakt_settings.json
# TRAKT_SYNC_DB_PATH=./runtime/trakt_sync.db
